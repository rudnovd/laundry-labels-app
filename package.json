{
  "name": "laundry-labels",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "description": "Store data on the care of your clothes",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  },
  "homepage": "https://laundrylabels.netlify.app/",
  "repository": "github:rudnovd/laundry-labels",
  "bugs": {
    "url": "https://github.com/rudnovd/laundry-labels/issues"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "npm run lint -- --fix",
    "lint:css": "stylelint src/**/*{.css,.vue}",
    "lint:css:fix": "npm run lint:css -- --fix",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build --apk",
    "update-types": "pnpm exec supabase gen types --lang=typescript > ./src/types/supabase.ts && eslint --fix ./src/types/supabase.ts"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@iconify/vue": "^5.0.2",
    "@regle/core": "^1.29.1",
    "@regle/rules": "^1.29.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-deep-link": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@vueuse/core": "^14.4.0",
    "compressorjs": "^1.3.0",
    "dexie": "^4.4.6",
    "driver.js": "^1.8.0",
    "es-toolkit": "^1.52.0",
    "pinia": "^3.0.4",
    "temporal-polyfill": "^1.0.5",
    "v-wave": "^3.1.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-rem-over-px": "^2.0.1",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
