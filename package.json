{
  "name": "laundry-labels-app",
  "type": "module",
  "version": "0.0.0-beta.2",
  "private": true,
  "description": "Store data on the care of your clothes",
  "homepage": "https://laundrylabels.netlify.app/",
  "repository": "github:rudnovd/laundry-labels-app",
  "bugs": {
    "url": "https://github.com/rudnovd/laundry-labels-app/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite",
    "build": "cross-env NODE_ENV=production npm run lint:all && vite build",
    "preview": "vite preview",
    "https": "PORT=4444 REINSTALL=true serve dist",
    "lint": "eslint --ext .ts,.vue src",
    "lint:fix": "npm run lint -- --fix",
    "lint:ts": "vue-tsc --build --force",
    "lint:css": "stylelint **/*{.scss,.vue}",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:all": "npm run lint && npm run lint:ts && npm run lint:css"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@quasar/extras": "^1.18.0",
    "@supabase/supabase-js": "^2.103.0",
    "@vueuse/core": "^14.2.1",
    "compressorjs": "^1.3.0",
    "dexie": "^4.4.2",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "quasar": "^2.22.0",
    "shepherd.js": "^15.2.2",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.1",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@quasar/vite-plugin": "^1.11.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "25.6.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.2.0",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.0.0",
    "supabase": "^2.89.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.2.0",
    "vite-svg-loader": "^5.1.1",
    "vue-tsc": "^3.2.6",
    "workbox-build": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
